# The Dockerfile copies only mix.exs, mix.lock, config/, priv, lib, assets and
# rel. Everything else was being uploaded to the builder on every deploy —
# 1.7 GB of context, of which roughly 1.3 GB is this list.

# Build artefacts — rebuilt inside the image
_build/
deps/
.elixir_ls/
priv/plts/

# Repo and tooling state
.git/
.github/
.claude/
.vscode/
.idea/

# Assets are compiled in the image from source
assets/node_modules/
priv/static/assets/
priv/static/cache_manifest.json

# Not needed at runtime
test/
docs/
design/
e2e/
*.md
.env
.env.*
!.env.example
.DS_Store
erl_crash.dump
npm-debug.log
