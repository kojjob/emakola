# =============================================================================
# Emakola environment reference
# =============================================================================
# Phoenix/Elixir does NOT load this file automatically. Copy it only if your
# shell, direnv, container runtime, or deployment platform is configured to load
# it, and export only the settings needed for that environment.
#
# Every value is commented to prevent placeholder credentials from being used
# accidentally. Never commit the populated file or paste secrets into logs.
# Production setup and provider-specific instructions live in:
#   docs/DEPLOYMENT.md
#   docs/PROVIDER_SETUP.md
# =============================================================================

# -----------------------------------------------------------------------------
# Local development and test overrides
# -----------------------------------------------------------------------------

# Development listens on 4000 by default.
# PORT=4000

# Enables sample/demo behaviour in any environment when exactly "true".
# DEMO_MODE=false

# Development-only escape hatch for automated browser tests. Never set in prod.
# DISABLE_RATE_LIMIT=1

# Use a unique suffix when tests run concurrently or from multiple worktrees.
# MIX_TEST_PARTITION=developer_a

# Optional browser path for the tagged PDF test. The production image defaults
# to /usr/bin/chromium and enables no_sandbox for its container runtime.
# CHROME_EXECUTABLE=/path/to/chromium
# CHROME_NO_SANDBOX=false

# -----------------------------------------------------------------------------
# Production core — required unless a comment says otherwise
# -----------------------------------------------------------------------------

# Starts the Phoenix endpoint in a release. rel/overlays/bin/server sets this.
# PHX_SERVER=true

# Canonical hostname used for URL generation, OAuth callbacks, and origin checks.
# PHX_HOST=makola.io

# PostgreSQL connection string. Fly sets this when the database is attached.
# DATABASE_URL=ecto://USER:PASSWORD@HOST:5432/emakola

# TLS verifies the database hostname and certificate by default. Set false only
# for a private encrypted network such as Fly 6PN to a .internal Postgres host.
# DATABASE_SSL=true

# POOL_SIZE=10
# ECTO_IPV6=true

# Generate independently with `mix phx.gen.secret` and
# `mix phx.gen.secret 64`. Never reuse either value elsewhere.
# SECRET_KEY_BASE=replace_with_generated_secret
# TOKEN_SIGNING_SECRET=replace_with_independent_generated_secret

# Application-level field encryption keyrings. Generate each 32-byte value
# independently with `openssl rand -base64 32`. Keep old encryption keys during
# rotation so existing envelopes remain readable; never reuse encryption key
# material for blind indexes.
# FIELD_ENCRYPTION_ACTIVE_KEY_ID=2026_08
# FIELD_ENCRYPTION_KEYS={"2026_08":"replace_with_base64_32_bytes"}
# FIELD_BLIND_INDEX_ACTIVE_KEY_ID=lookup_2026_08
# FIELD_BLIND_INDEX_KEYS={"lookup_2026_08":"replace_with_different_base64_32_bytes"}

# DNSCluster query for multi-node releases; leave unset for a single node.
# DNS_CLUSTER_QUERY=emakola.internal

# Standard Elixir release distribution cookie. Required when clustering outside
# platforms that inject it securely; every node in the cluster must share it.
# RELEASE_COOKIE=replace_with_generated_release_cookie

# Private Prometheus listener. Do not expose this port through the public router.
# METRICS_PORT=9091

# -----------------------------------------------------------------------------
# Required production providers
# -----------------------------------------------------------------------------

# Transactional email via Resend.
# RESEND_API_KEY=re_live_replace_me

# Paystack server and browser checkout keys. Both are required at prod boot.
# PAYSTACK_SECRET_KEY=sk_live_replace_me
# PAYSTACK_PUBLIC_KEY=pk_live_replace_me

# SMS_API_KEY is required. Generic mode also requires SMS_API_URL; arkesel mode
# uses the built-in Arkesel endpoint when SMS_API_URL is absent.
# SMS_PROVIDER=arkesel
# SMS_API_KEY=replace_me
# SMS_API_URL=https://sms.provider.example/v1/messages
# SMS_SENDER_ID=Makola

# WhatsApp Business Cloud API credentials are required at prod boot.
# WHATSAPP_API_TOKEN=replace_me
# WHATSAPP_PHONE_NUMBER_ID=replace_me
# WHATSAPP_API_VERSION=v21.0

# -----------------------------------------------------------------------------
# Storage — optional at boot, required for uploads
# -----------------------------------------------------------------------------

# Missing credentials produce a boot warning and make S3 uploads fail. AWS_S3_*
# names take precedence. Fly/Tigris injects BUCKET_NAME and AWS_REGION aliases.
# AWS_ACCESS_KEY_ID=replace_me
# AWS_SECRET_ACCESS_KEY=replace_me
# AWS_S3_BUCKET=emakola-uploads
# AWS_S3_REGION=eu-west-1
# AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
# BUCKET_NAME=emakola-uploads
# AWS_REGION=auto

# -----------------------------------------------------------------------------
# Optional payment gateway
# -----------------------------------------------------------------------------

# If HUBTEL_CLIENT_ID is set, HUBTEL_CLIENT_SECRET is also required. Hubtel does
# not sign webhooks; an empty allowlist makes the webhook endpoint fail closed.
# HUBTEL_CLIENT_ID=replace_me
# HUBTEL_CLIENT_SECRET=replace_me
# HUBTEL_WEBHOOK_ALLOWLIST=203.0.113.5,198.51.100.0/24

# -----------------------------------------------------------------------------
# Optional authentication providers and features
# -----------------------------------------------------------------------------

# OAuth providers ship dark. Configure a complete provider pair/set to expose it.
# GOOGLE_CLIENT_ID=replace_me.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=replace_me
# FACEBOOK_CLIENT_ID=replace_me
# FACEBOOK_CLIENT_SECRET=replace_me
# APPLE_CLIENT_ID=com.example.web
# APPLE_TEAM_ID=replace_me
# APPLE_KEY_ID=replace_me
# APPLE_PRIVATE_KEY_PATH=/run/secrets/AuthKey_replace_me.p8

# Reveal phone authentication only after its delivery path is production-ready.
# PHONE_AUTH_ENABLED=false

# -----------------------------------------------------------------------------
# Optional push, search, AI, and error monitoring
# -----------------------------------------------------------------------------

# FCM_PROJECT_ID is required whenever FCM_SERVICE_ACCOUNT_JSON is set.
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# FCM_PROJECT_ID=replace_me

# Search Console sync ships dark without credentials. GSC_SITE_URL must match the
# property kind, for example sc-domain:makola.io for a Domain property.
# GSC_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# GSC_SITE_URL=sc-domain:makola.io

# Anthropic-backed content generation ships dark when unset.
# ANTHROPIC_API_KEY=replace_me

# Sentry is inert without a DSN. Release is an optional deploy identifier.
# SENTRY_DSN=https://public_key@organization.ingest.sentry.io/project
# SENTRY_RELEASE=git_sha_or_release_name

# -----------------------------------------------------------------------------
# Domains, redirects, and public contact details
# -----------------------------------------------------------------------------

# Enable branded merchant subdomains only after wildcard DNS and TLS are ready.
# STORE_SUBDOMAIN_BASE=makola.io

# Comma-separated aliases redirected to PHX_HOST. An explicitly empty value
# disables redirects. See config/runtime.exs for the makola.io defaults.
# CANONICAL_REDIRECT_HOSTS=www.makola.io,emakola.fly.dev

# Outbound sender addresses are formed from this domain.
# MAIL_FROM_DOMAIN=makola.io

# Public contact details have defaults but should be set for the deployed brand.
# CONTACT_EMAIL=support@makola.io
# CAREERS_EMAIL=careers@makola.io
# PRESS_EMAIL=press@makola.io
# SUPPORT_WHATSAPP=233200000000
# SUPPORT_PHONE=+233 20 000 0000

# SplitPay tenant client (ship-dark; pay links route through SplitPay when set)
# SPLITPAY_API_URL=https://splitpay-sandbox.fly.dev
# SPLITPAY_API_KEY=sk_sandbox_...
# SPLITPAY_WEBHOOK_SECRET=whsec_...
