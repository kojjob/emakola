# =============================================================================
# Emakola Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# PostgreSQL connection string
# Format: ecto://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=ecto://postgres:postgres@localhost:5432/emakola_dev

# Phoenix secret key base — generate with: mix phx.gen.secret
SECRET_KEY_BASE=CHANGE_ME_generate_with_mix_phx_gen_secret_minimum_64_bytes

# AshAuthentication token signing secret (required in prod) — generate with:
# mix phx.gen.secret 64
TOKEN_SIGNING_SECRET=CHANGE_ME_generate_with_mix_phx_gen_secret_64

# Hostname for URL generation (used in emails, webhooks, etc.)
PHX_HOST=localhost

# HTTP port (read as PORT by config/runtime.exs)
PORT=4000

# Database connection pool size
POOL_SIZE=10

# Database TLS (prod only). Defaults to "true" = verify_peer against the OS
# trust store. Set to "false" ONLY for private networking (e.g. Fly.io 6PN
# to a .internal Postgres). Keep "true" for any external database.
# DATABASE_SSL=true

# Elixir release cookie (for distributed Erlang in production)
# RELEASE_COOKIE=CHANGE_ME

# BEAM clustering — DNS query DNSCluster uses to discover peer nodes.
# On Fly.io this is set in fly.toml ([env]) to "emakola.internal".
# Leave unset for single-node / local development.
# DNS_CLUSTER_QUERY=emakola.internal

# -----------------------------------------------------------------------------
# Payment Gateways
# -----------------------------------------------------------------------------

# Paystack (https://dashboard.paystack.com/#/settings/developer)
# Use test keys for development — they start with sk_test_ and pk_test_
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Hubtel (https://developers.hubtel.com/)
# Optional — only needed if testing Hubtel mobile money integration
HUBTEL_CLIENT_ID=your_hubtel_client_id
HUBTEL_CLIENT_SECRET=your_hubtel_client_secret

# Hubtel webhook source-IP allowlist (REQUIRED in production).
# Comma-separated IPv4 addresses or CIDR ranges. Hubtel does not sign
# webhooks, so conn.remote_ip is the only trust boundary. If this variable
# is empty, the /webhooks/hubtel endpoint rejects EVERY request with 403.
# Get the current IP ranges from Hubtel support or developer docs.
# Example: HUBTEL_WEBHOOK_ALLOWLIST=203.0.113.5,198.51.100.0/24
HUBTEL_WEBHOOK_ALLOWLIST=

# -----------------------------------------------------------------------------
# File Storage (S3-Compatible)
# -----------------------------------------------------------------------------

# AWS S3 or compatible service (DigitalOcean Spaces, MinIO, etc.)
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_S3_BUCKET=emakola-uploads-dev
AWS_S3_REGION=eu-west-1

# Custom S3 endpoint for non-AWS providers (Tigris, DigitalOcean Spaces,
# MinIO). On Fly.io, `fly storage create` sets this automatically.
# AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev

# -----------------------------------------------------------------------------
# Notifications — WhatsApp
# -----------------------------------------------------------------------------

# WhatsApp Business API (https://developers.facebook.com/docs/whatsapp)
# Optional for local development
WHATSAPP_API_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# -----------------------------------------------------------------------------
# Notifications — SMS
# -----------------------------------------------------------------------------

# SMS gateway API key (e.g., Arkesel, Termii, Africa's Talking)
SMS_API_KEY=your_sms_api_key_here
SMS_SENDER_ID=Emakola
# "arkesel" speaks Arkesel v2 natively (api-key header, sender/message/recipients
# payload, endpoint defaulted) — SMS_API_URL becomes optional. Default: generic
# Bearer gateway contract.
SMS_PROVIDER=arkesel
# SMS gateway send-message endpoint (required in prod unless SMS_PROVIDER=arkesel)
# SMS_API_URL=https://sms.yourprovider.example/v1/messages

# -----------------------------------------------------------------------------
# Notifications — Email (Resend, required in prod)
# -----------------------------------------------------------------------------

# Resend API key (https://resend.com) — transactional email via Swoosh
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Notifications — Mobile Push (FCM HTTP v1)
# -----------------------------------------------------------------------------

# Firebase Cloud Messaging — required only when sending push notifications to
# the mobile app. Omit both to use the LogPush provider (logs to stdout only).
#
# FCM_SERVICE_ACCOUNT_JSON: full JSON content of the Firebase service-account
# key file (download from Firebase Console → Project Settings → Service Accounts
# → Generate new private key). Keep this secret.
# FCM_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"...",...}'
# FCM_PROJECT_ID=your-firebase-project-id

# -----------------------------------------------------------------------------
# Optional — Monitoring & Observability
# -----------------------------------------------------------------------------

# Sentry error tracking (https://sentry.io)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# AppSignal APM (https://appsignal.com)
# APPSIGNAL_PUSH_API_KEY=your_appsignal_key
