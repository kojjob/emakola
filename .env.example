# =============================================================================
# Emakola Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# PostgreSQL connection string
# Format: ecto://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=ecto://postgres:postgres@localhost:5432/emakola_dev

# Phoenix secret key base — generate with: mix phx.gen.secret
SECRET_KEY_BASE=CHANGE_ME_generate_with_mix_phx_gen_secret_minimum_64_bytes

# Hostname for URL generation (used in emails, webhooks, etc.)
PHX_HOST=localhost

# HTTP port
PHX_PORT=4000

# Database connection pool size
POOL_SIZE=10

# Elixir release cookie (for distributed Erlang in production)
# RELEASE_COOKIE=CHANGE_ME

# -----------------------------------------------------------------------------
# Payment Gateways
# -----------------------------------------------------------------------------

# Paystack (https://dashboard.paystack.com/#/settings/developer)
# Use test keys for development — they start with sk_test_ and pk_test_
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Hubtel (https://developers.hubtel.com/)
# Optional — only needed if testing Hubtel mobile money integration
HUBTEL_CLIENT_ID=your_hubtel_client_id
HUBTEL_CLIENT_SECRET=your_hubtel_client_secret

# -----------------------------------------------------------------------------
# File Storage (S3-Compatible)
# -----------------------------------------------------------------------------

# AWS S3 or compatible service (DigitalOcean Spaces, MinIO, etc.)
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_S3_BUCKET=emakola-uploads-dev
AWS_S3_REGION=eu-west-1

# Optional: custom S3 endpoint for non-AWS providers
# AWS_S3_ENDPOINT=https://nyc3.digitaloceanspaces.com

# -----------------------------------------------------------------------------
# Notifications — WhatsApp
# -----------------------------------------------------------------------------

# WhatsApp Business API (https://developers.facebook.com/docs/whatsapp)
# Optional for local development
WHATSAPP_API_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# -----------------------------------------------------------------------------
# Notifications — SMS
# -----------------------------------------------------------------------------

# SMS gateway API key (e.g., Arkesel, Termii, Africa's Talking)
SMS_API_KEY=your_sms_api_key_here
SMS_SENDER_ID=Emakola

# -----------------------------------------------------------------------------
# Background Jobs (Oban)
# -----------------------------------------------------------------------------

# Queue concurrency settings (number of concurrent workers per queue)
OBAN_QUEUE_DEFAULT=10
OBAN_QUEUE_NOTIFICATIONS=5
OBAN_QUEUE_WEBHOOKS=5
OBAN_QUEUE_IMAGES=3
OBAN_QUEUE_MAILERS=5

# -----------------------------------------------------------------------------
# Optional — Monitoring & Observability
# -----------------------------------------------------------------------------

# Sentry error tracking (https://sentry.io)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# AppSignal APM (https://appsignal.com)
# APPSIGNAL_PUSH_API_KEY=your_appsignal_key

# -----------------------------------------------------------------------------
# Optional — Email (for transactional emails)
# -----------------------------------------------------------------------------

# SMTP or API-based email provider
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@example.com
# SMTP_PASSWORD=your_email_password
# MAIL_FROM=noreply@emakola.com
