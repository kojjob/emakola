<!DOCTYPE html>
<html lang="en" class="dark [scrollbar-gutter:stable]">
  <head>
    <script>
      // Prevent Flash of Unstyled Content (FOUC) for theme
      (function() {
        var theme = localStorage.getItem('theme');
        var isLight = theme === 'light' || (!theme && window.matchMedia('(prefers-color-scheme: light)').matches);
        if (isLight) {
          document.documentElement.classList.remove('dark');
          document.documentElement.setAttribute('data-theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta
      name="description"
      content={assigns[:meta_description] || "Your online store powered by Emakola"}
    />
    <meta name="robots" content={assigns[:robots] || "index, follow"} />
    <%= if assigns[:canonical_url] do %>
      <link rel="canonical" href={assigns[:canonical_url]} />
    <% end %>
    <!-- Open Graph -->
    <meta property="og:title" content={assigns[:page_title] || "Emakola"} />
    <meta
      property="og:description"
      content={assigns[:meta_description] || "Your online store powered by Emakola"}
    />
    <meta property="og:type" content="website" />
    <%= if assigns[:og_image] do %>
      <meta property="og:image" content={assigns[:og_image]} />
    <% end %>
    <%= if assigns[:canonical_url] do %>
      <meta property="og:url" content={assigns[:canonical_url]} />
    <% end %>
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={assigns[:page_title] || "Emakola"} />
    <meta
      name="twitter:description"
      content={assigns[:meta_description] || "Your online store powered by Emakola"}
    />
    <%= if assigns[:og_image] do %>
      <meta name="twitter:image" content={assigns[:og_image]} />
    <% end %>
    <!-- JSON-LD Structured Data -->
    <%= if assigns[:json_ld] do %>
      <script type="application/ld+json">
        {raw(assigns[:json_ld])}
      </script>
    <% end %>
    <.live_title default="Emakola" suffix=" · Emakola">
      {assigns[:page_title]}
    </.live_title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Manrope:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
