<!DOCTYPE html>
<html lang="en" class="[scrollbar-gutter:stable]">
  <head>
    <script phx-track-static type="text/javascript" src={~p"/assets/js/theme-init.js"}>
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <EmakolaWeb.SEO.meta_tags
      title={assigns[:page_title] || "Emakola"}
      description={assigns[:meta_description] || "Your online store powered by Emakola"}
      canonical_url={assigns[:canonical_url]}
      og_image={assigns[:og_image]}
      og_type={assigns[:og_type] || "website"}
      site_name={assigns[:og_site_name] || "Emakola"}
      robots={assigns[:robots] || "index, follow"}
      json_ld={assigns[:json_ld]}
    />
    <.live_title default="Emakola">
      {assigns[:page_title]}
    </.live_title>
    <%!--
      Font loading strategy for low-bandwidth mobile networks:
      1. preconnect to both hosts early (DNS + TCP + TLS in parallel with HTML parse)
      2. display=swap is already in the URL — text renders with system font while
         web font loads, preventing FOIT (flash of invisible text)
      3. media="print" + onload="this.media='all'" defers stylesheet download
         until after critical CSS loads. Noscript fallback keeps it accessible.
    --%>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Manrope:wght@600;700;800&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Manrope:wght@600;700;800&display=swap"
      />
    </noscript>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      />
    </noscript>
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0C1F17" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="apple-touch-icon" href="/images/icons/icon-192.png" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="bg-[#0c1526]">
    {@inner_content}
  </body>
</html>
