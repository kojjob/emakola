<%!-- Theme font loading --%>
<link :if={assigns[:theme_fonts]} rel="preconnect" href="https://fonts.googleapis.com" />
<link
  :if={assigns[:theme_fonts]}
  rel="preconnect"
  href="https://fonts.gstatic.com"
  crossorigin=""
/>
<link :if={assigns[:theme_fonts]} rel="stylesheet" href={@theme_fonts.url} />

<%!-- Theme CSS variables injection --%>
<style :if={assigns[:theme]}>
  :root {
    --theme-primary: <%= @theme.colors.primary %>;
    --theme-secondary: <%= @theme.colors.secondary %>;
    --theme-accent: <%= @theme.colors.accent %>;
    --theme-background: <%= @theme.colors.background %>;
    --theme-text: <%= @theme.colors.text %>;
  }
</style>

<div
  class="min-h-screen flex flex-col bg-[#FAFAF9] text-[#0F172A] font-[Inter,system-ui,-apple-system,sans-serif] antialiased"
  style={
    if assigns[:theme_fonts],
      do: "font-family: #{@theme_fonts.body}, system-ui, -apple-system, sans-serif",
      else: nil
  }
>
  <!-- Top Bar -->
  <header class="sticky top-0 z-50 bg-white border-b border-[#E2E8F0]">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-14 sm:h-16">
        <!-- Store info -->
        <a
          :if={assigns[:store]}
          href={"/s/#{@store.slug}"}
          class="flex items-center gap-2.5 min-w-0"
        >
          <div class="w-10 h-10 rounded-full bg-[#E2E8F0] flex items-center justify-center flex-shrink-0 border-2 border-[#E2E8F0] overflow-hidden">
            <span class="text-sm font-bold text-[#475569]">
              {String.first(@store.name)}
            </span>
          </div>
          <div class="min-w-0">
            <div class="text-[0.9375rem] font-semibold text-[#0F172A] truncate leading-tight">
              {@store.name}
            </div>
            <div class="flex items-center gap-1 text-xs text-[#94A3B8] leading-tight">
              <span class="w-1.5 h-1.5 rounded-full bg-[#059669] flex-shrink-0"></span>
              <span>Open</span>
            </div>
          </div>
        </a>
        <a :if={!assigns[:store]} href="/" class="text-lg font-bold tracking-tight">Shop</a>
        
<!-- Right icons -->
        <div class="flex items-center gap-1">
          <!-- Search -->
          <button
            :if={assigns[:store]}
            class="flex items-center justify-center w-10 h-10 rounded-full text-[#0F172A] hover:bg-[#F1F5F9] transition-colors"
            aria-label="Search products"
            type="button"
          >
            <svg
              class="w-[22px] h-[22px]"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.8"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"
              />
            </svg>
          </button>
          <!-- Cart -->
          <a
            :if={assigns[:store]}
            href={"/s/#{@store.slug}/cart"}
            class="flex items-center justify-center w-10 h-10 rounded-full text-[#0F172A] hover:bg-[#F1F5F9] transition-colors relative"
            aria-label={"Shopping bag#{if assigns[:cart_count] && @cart_count > 0, do: ", #{@cart_count} items", else: ""}"}
          >
            <svg
              class="w-[22px] h-[22px]"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.8"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"
              />
            </svg>
            <span
              :if={assigns[:cart_count] && @cart_count > 0}
              class="absolute top-1 right-1 w-[18px] h-[18px] rounded-full bg-[#B45309] text-white text-[0.625rem] font-bold flex items-center justify-center leading-none"
            >
              {@cart_count}
            </span>
          </a>
        </div>
      </div>
    </div>
  </header>
  
<!-- Flash messages -->
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 w-full">
    <.flash_group flash={@flash} />
  </div>
  
<!-- Main content -->
  <main class="flex-1">
    {@inner_content}
  </main>
  
<!-- WhatsApp FAB -->
  <a
    :if={assigns[:store]}
    href={"https://wa.me/?text=Hi%20#{URI.encode(@store.name)}"}
    target="_blank"
    rel="noopener noreferrer"
    class="fixed bottom-6 right-6 w-14 h-14 rounded-full bg-[#25D366] flex items-center justify-center shadow-[0_4px_16px_rgba(37,211,102,0.35)] hover:scale-[1.08] hover:shadow-[0_6px_24px_rgba(37,211,102,0.45)] active:scale-[0.96] transition-transform z-50"
    aria-label="Chat on WhatsApp"
  >
    <svg class="w-7 h-7 text-white" viewBox="0 0 24 24" fill="currentColor">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
    </svg>
  </a>
  
<!-- Footer -->
  <footer class="bg-white border-t border-[#E2E8F0] mt-auto">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 py-8 pb-24 text-center">
      <p :if={assigns[:store]} class="text-[0.9375rem] font-semibold text-[#0F172A] mb-1">
        {@store.name}
      </p>
      <p :if={assigns[:store]} class="text-[0.8125rem] text-[#94A3B8] mb-4">
        Accra, Ghana
      </p>
      <!-- Payment badges -->
      <div class="flex justify-center gap-2.5 flex-wrap mb-5">
        <span class="inline-flex items-center px-2.5 py-1 bg-[#F1F5F9] rounded-lg text-[0.625rem] font-semibold text-[#475569] tracking-wide">
          MTN MoMo
        </span>
        <span class="inline-flex items-center px-2.5 py-1 bg-[#F1F5F9] rounded-lg text-[0.625rem] font-semibold text-[#475569] tracking-wide">
          Vodafone Cash
        </span>
        <span class="inline-flex items-center px-2.5 py-1 bg-[#F1F5F9] rounded-lg text-[0.625rem] font-semibold text-[#475569] tracking-wide">
          Visa
        </span>
        <span class="inline-flex items-center px-2.5 py-1 bg-[#F1F5F9] rounded-lg text-[0.625rem] font-semibold text-[#475569] tracking-wide">
          Mastercard
        </span>
      </div>
      <p class="text-[0.6875rem] text-[#94A3B8] mb-2">
        Powered by <span class="font-semibold text-[#475569]">Emakola</span>
      </p>
      <p :if={assigns[:store]} class="text-[0.6875rem] text-[#94A3B8]">
        &copy; {Date.utc_today().year} {@store.name}
      </p>
    </div>
  </footer>
</div>
