<%!--
  Storefront layout — renders the structural shell around theme content.

  IMPORTANT: This layout must NOT resolve the theme or inject CSS variables.
  Theme resolution is handled exclusively by the ResolveStore on_mount hook
  (lib/emakola_web/hooks/resolve_store.ex), which sets:

    @store        — the resolved store struct
    @theme        — fully resolved theme config (colors, fonts, sections, etc.)
    @theme_module — the theme module (Atelier, Market, Vibrant, etc.)
    @theme_fonts  — list of Google Fonts URLs for the theme

  CSS variables (:root custom properties) are injected by each theme's
  `theme_styles/1` component, NOT by this layout. Having two sources of
  CSS variables (layout + theme template) caused a race condition where
  LiveView DOM patching would briefly show the layout's defaults before
  the theme's overrides took effect — the "old design flash" bug.

  The layout's job is:
  1. Load theme fonts via <link> tags (from @theme_fonts)
  2. Render the flash messages
  3. Render the inner content (which includes the theme's own nav/footer)
  4. Show fallback nav/footer/WhatsApp FAB only when no theme_module is set
  5. Render the search overlay
--%>

<%!-- Theme font loading (from ResolveStore hook) --%>
<%= if assigns[:theme_fonts] && is_list(assigns[:theme_fonts]) do %>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
  <%= for font_url <- @theme_fonts do %>
    <link rel="stylesheet" href={font_url} />
  <% end %>
<% end %>

<%!--
  CSS variables + design token fonts.

  These :root variables are the BASELINE for all themes. Themes that define
  their own theme_styles/1 (most do) will override these in a later <style>
  block. Themes that don't rely on these as their ONLY source of --theme-*
  values.

  IMPORTANT: We read from assigns[:theme] which is set by the ResolveStore
  hook — NO independent re-resolution. This eliminates the race condition
  that caused the "old design flash" while still providing CSS variables
  for all themes.
--%>
<%= if assigns[:theme] do %>
  <% tokens = Map.get(assigns[:theme], :design_tokens, %{})
  heading_font = Emakola.Themes.DesignTokens.heading_font_family(tokens[:heading_font] || "sans")
  body_font = Emakola.Themes.DesignTokens.body_font_family(tokens[:body_font] || "sans")
  heading_url = Emakola.Themes.DesignTokens.heading_font_url(tokens[:heading_font] || "sans")
  body_url = Emakola.Themes.DesignTokens.body_font_url(tokens[:body_font] || "sans")
  root_font_size = Emakola.Themes.DesignTokens.root_font_size(tokens[:typography_scale]) %>
  <%= if heading_url do %>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
    <link rel="stylesheet" href={heading_url} />
  <% end %>
  <%= if body_url && body_url != heading_url do %>
    <link rel="stylesheet" href={body_url} />
  <% end %>
  <%!--
    Font rules are emitted ONLY when the merchant explicitly picked a font
    token. The default token resolves to "inherit", which is a CSS-wide
    keyword — invalid as a custom-property value — so an unconditional
    `!important` rule here made every heading fall back to the body font
    and silently defeated all theme heading fonts (Manrope, Fraunces, ...).
  --%>
  <style>
    :root {
      --theme-primary: <%= EmakolaWeb.Helpers.CssColor.safe_css_color(assigns[:theme][:colors][:primary], "#2563EB") %>;
      --theme-accent: <%= EmakolaWeb.Helpers.CssColor.safe_css_color(assigns[:theme][:colors][:accent], "#0F172A") %>;
      --theme-bg: <%= EmakolaWeb.Helpers.CssColor.safe_css_color(assigns[:theme][:colors][:background], "#FFFFFF") %>;
      <%= if heading_font != "inherit" do %>--dt-heading-font: <%= heading_font %>;<% end %>
      <%= if body_font != "inherit" do %>--dt-body-font: <%= body_font %>;<% end %>
      --dt-btn-radius: <%= case tokens[:button_style] do "pill" -> "9999px"; "square" -> "0px"; _ -> "0.5rem" end %>;
    }
    <%!--
      Typography scale, applied at the root so it scales type AND spacing
      together — every theme sizes both in Tailwind's rem units, so this is
      the one place the control can work on all 21 without per-theme markup.
      Emitted only when the merchant moved off the default.

      root_font_size/1 pattern-matches "compact"/"spacious" and returns a
      hardcoded value, falling through to nil, so a merchant-supplied
      theme_config value can never reach this <style> block.
    --%>
    <%= if root_font_size do %>
    :root { font-size: <%= root_font_size %>; }
    <% end %>
    <%= if heading_font != "inherit" do %>
    h1, h2, h3, h4, h5, h6 { font-family: var(--dt-heading-font) !important; }
    <% end %>
    <%= if body_font != "inherit" do %>
    p, span, a, li, td, th, label, input, textarea, select, div {
      font-family: var(--dt-body-font);
    }
    <% end %>
    .dt-btn {
      border-radius: var(--dt-btn-radius) !important;
    }
  </style>
<% end %>

<div
  class="min-h-screen flex flex-col bg-[#FAFAF9] text-[#0C0A09] font-[Inter,system-ui,-apple-system,sans-serif] antialiased"
  style={
    with %{} <- assigns[:theme],
         family when family != "inherit" <-
           Emakola.Themes.DesignTokens.body_font_family(
             assigns[:theme][:design_tokens][:body_font] || "sans"
           ) do
      "font-family: #{family}"
    else
      _ -> nil
    end
  }
>
  <!-- Top Bar (hidden when theme provides its own nav) -->
  <header
    :if={!assigns[:theme_module]}
    class="sticky top-0 z-50 bg-white border-b border-[#E2E8F0]"
  >
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-14 sm:h-16">
        <!-- Store info -->
        <a
          :if={assigns[:store]}
          href={EmakolaWeb.Storefront.Path.store_path(@store.slug, "/")}
          class="flex items-center gap-2.5 min-w-0"
        >
          <div class="w-10 h-10 rounded-full bg-[#E2E8F0] flex items-center justify-center flex-shrink-0 border-2 border-[#E2E8F0] overflow-hidden">
            <span class="text-sm font-bold text-[#475569]">
              {String.first(@store.name)}
            </span>
          </div>
          <div class="min-w-0">
            <div class="text-[0.9375rem] font-semibold text-slate-900 truncate leading-tight">
              {@store.name}
            </div>
            <div class="flex items-center gap-1 text-xs text-[#94A3B8] leading-tight">
              <span class="w-1.5 h-1.5 rounded-full bg-[#059669] flex-shrink-0"></span>
              <span>Open</span>
            </div>
          </div>
        </a>
        <a :if={!assigns[:store]} href="/" class="text-lg font-bold tracking-tight">Shop</a>
        
<!-- Right icons -->
        <div class="flex items-center gap-1">
          <!-- Search -->
          <button
            :if={assigns[:store]}
            phx-click={EmakolaWeb.SearchComponents.show_search()}
            class="flex items-center justify-center w-10 h-10 rounded-full text-slate-900 hover:bg-[#F1F5F9] transition-colors"
            aria-label="Search products"
            type="button"
          >
            <svg
              class="w-[22px] h-[22px]"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.8"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"
              />
            </svg>
          </button>
          <!-- Cart -->
          <a
            :if={assigns[:store]}
            href={EmakolaWeb.Storefront.Path.store_path(@store.slug, "/cart")}
            class="flex items-center justify-center w-10 h-10 rounded-full text-slate-900 hover:bg-[#F1F5F9] transition-colors relative"
            aria-label={"Shopping bag#{if assigns[:cart_count] && @cart_count > 0, do: ", #{Emakola.Plural.count(@cart_count, "item")}", else: ""}"}
          >
            <svg
              class="w-[22px] h-[22px]"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.8"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"
              />
            </svg>
            <span
              :if={assigns[:cart_count] && @cart_count > 0}
              class="absolute top-1 right-1 w-[18px] h-[18px] rounded-full bg-store-accent text-white text-[0.625rem] font-bold flex items-center justify-center leading-none"
            >
              {@cart_count}
            </span>
          </a>
        </div>
      </div>
    </div>
  </header>

  <%!-- Search overlay --%>
  <%= if assigns[:store] do %>
    <EmakolaWeb.SearchComponents.search_overlay
      store={@store}
      search_query={assigns[:search_overlay_query] || ""}
      search_results={assigns[:search_overlay_results] || []}
      searching={assigns[:searching] || false}
      total_results={assigns[:search_overlay_total] || 0}
    />
  <% end %>
  
<!-- Flash messages -->
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 w-full">
    <.flash_group flash={@flash} />
  </div>
  
<!-- Main content -->
  <main class="flex-1">
    {@inner_content}
  </main>
  
<!-- WhatsApp FAB (hidden when theme provides its own) -->
  <a
    :if={assigns[:store] && !assigns[:theme_module] && assigns[:store].whatsapp_number}
    href={"https://wa.me/#{@store.whatsapp_number}?text=Hi!%20I'm%20browsing%20your%20store."}
    target="_blank"
    rel="noopener noreferrer"
    class="fixed bottom-20 lg:bottom-6 right-6 w-14 h-14 rounded-full bg-whatsapp flex items-center justify-center shadow-[0_4px_16px_rgba(37,211,102,0.35)] hover:scale-[1.08] hover:shadow-[0_6px_24px_rgba(37,211,102,0.45)] active:scale-[0.96] transition-transform z-50"
    aria-label="Chat on WhatsApp"
  >
    <svg class="w-7 h-7 text-white" viewBox="0 0 24 24" fill="currentColor">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
    </svg>
  </a>
  
<!-- Footer (hidden when theme provides its own footer) -->
  <footer
    :if={!assigns[:theme_module]}
    class="bg-white border-t border-[#E2E8F0] mt-auto"
  >
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 py-8 pb-24 text-center">
      <p :if={assigns[:store]} class="text-[0.9375rem] font-semibold text-slate-900 mb-1">
        {@store.name}
      </p>
      <p :if={assigns[:store]} class="text-[0.8125rem] text-[#94A3B8] mb-4">
        Accra, Ghana
      </p>
      <!-- Payment badges -->
      <div class="flex justify-center gap-2.5 flex-wrap mb-5">
        <span class="inline-flex items-center px-2.5 py-1 bg-[#F1F5F9] rounded-lg text-[0.625rem] font-semibold text-[#475569] tracking-wide">
          MTN MoMo
        </span>
        <span class="inline-flex items-center px-2.5 py-1 bg-[#F1F5F9] rounded-lg text-[0.625rem] font-semibold text-[#475569] tracking-wide">
          Telecel Cash
        </span>
        <span class="inline-flex items-center px-2.5 py-1 bg-[#F1F5F9] rounded-lg text-[0.625rem] font-semibold text-[#475569] tracking-wide">
          Visa
        </span>
        <span class="inline-flex items-center px-2.5 py-1 bg-[#F1F5F9] rounded-lg text-[0.625rem] font-semibold text-[#475569] tracking-wide">
          Mastercard
        </span>
      </div>
      <p class="text-[0.6875rem] text-[#94A3B8] mb-2">
        Powered by <span class="font-semibold text-[#475569]">Makola</span>
      </p>
      <p :if={assigns[:store]} class="text-[0.6875rem] text-[#94A3B8]">
        &copy; {Date.utc_today().year} {@store.name}
      </p>
    </div>
  </footer>
  
<!-- Mobile Bottom Navigation -->
  <nav
    :if={assigns[:store] && !assigns[:theme_module]}
    class="fixed bottom-0 left-0 right-0 z-50 bg-white border-t border-[#E2E8F0] lg:hidden"
  >
    <div class="flex items-center justify-around h-16">
      <a
        href={EmakolaWeb.Storefront.Path.store_path(@store.slug, "/")}
        class={"flex flex-col items-center justify-center gap-0.5 min-w-[64px] py-1 #{if assigns[:current_path] == "/s/#{@store.slug}", do: "text-store-accent", else: "text-[#94A3B8]"}"}
      >
        <svg
          class="w-6 h-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"
          />
        </svg>
        <span class="text-[0.625rem] font-medium">Home</span>
      </a>
      <a
        href={EmakolaWeb.Storefront.Path.store_path(@store.slug, "/products")}
        class={"flex flex-col items-center justify-center gap-0.5 min-w-[64px] py-1 #{if assigns[:current_path] && String.contains?(assigns[:current_path], "/products"), do: "text-store-accent", else: "text-[#94A3B8]"}"}
      >
        <svg
          class="w-6 h-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"
          />
        </svg>
        <span class="text-[0.625rem] font-medium">Shop</span>
      </a>
      <a
        href={EmakolaWeb.Storefront.Path.store_path(@store.slug, "/cart")}
        class={"flex flex-col items-center justify-center gap-0.5 min-w-[64px] py-1 relative #{if assigns[:current_path] && String.contains?(assigns[:current_path], "/cart"), do: "text-store-accent", else: "text-[#94A3B8]"}"}
      >
        <div class="relative">
          <svg
            class="w-6 h-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z"
            />
          </svg>
          <span
            :if={(assigns[:cart_count] || 0) > 0}
            class="absolute -top-1.5 -right-1.5 w-4 h-4 rounded-full bg-store-accent text-white text-[0.5rem] font-bold flex items-center justify-center leading-none"
          >
            {assigns[:cart_count] || 0}
          </span>
        </div>
        <span class="text-[0.625rem] font-medium">Cart</span>
      </a>
      <a
        href={EmakolaWeb.Storefront.Path.store_path(@store.slug, "/account")}
        class={"flex flex-col items-center justify-center gap-0.5 min-w-[64px] py-1 #{if assigns[:current_path] && String.contains?(assigns[:current_path], "/account"), do: "text-store-accent", else: "text-[#94A3B8]"}"}
      >
        <svg
          class="w-6 h-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"
          />
        </svg>
        <span class="text-[0.625rem] font-medium">Account</span>
      </a>
    </div>
  </nav>
</div>
