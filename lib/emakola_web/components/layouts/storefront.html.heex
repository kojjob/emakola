<div class="min-h-screen flex flex-col bg-white text-gray-900">
  <!-- Header -->
  <header class="sticky top-0 z-40 bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="flex items-center justify-between h-14">
        <!-- Store name / logo -->
        <a
          href={if assigns[:store], do: "/s/#{@store.slug}", else: "#"}
          class="text-lg font-bold tracking-tight text-gray-900 truncate"
        >
          {if assigns[:store], do: @store.name, else: "Shop"}
        </a>
        
<!-- Desktop nav -->
        <nav class="hidden sm:flex items-center gap-6 text-sm font-medium">
          <a
            :if={assigns[:store]}
            href={"/s/#{@store.slug}"}
            class="text-gray-600 hover:text-gray-900 transition-colors"
          >
            Home
          </a>
          <a
            :if={assigns[:store]}
            href={"/s/#{@store.slug}/products"}
            class="text-gray-600 hover:text-gray-900 transition-colors"
          >
            Products
          </a>
          <a
            :if={assigns[:store]}
            href={"/s/#{@store.slug}/cart"}
            class="relative text-gray-600 hover:text-gray-900 transition-colors"
          >
            Cart
            <span
              :if={assigns[:cart_count] && @cart_count > 0}
              class="absolute -top-2 -right-4 bg-indigo-600 text-white text-xs font-bold rounded-full w-5 h-5 flex items-center justify-center"
            >
              {@cart_count}
            </span>
          </a>
        </nav>
        
<!-- Mobile hamburger -->
        <button
          id="mobile-menu-toggle"
          class="sm:hidden p-2 -mr-2 text-gray-600 hover:text-gray-900"
          phx-click={
            Phoenix.LiveView.JS.toggle(
              to: "#mobile-menu",
              in:
                {"ease-out duration-200", "opacity-0 -translate-y-2", "opacity-100 translate-y-0"},
              out:
                {"ease-in duration-150", "opacity-100 translate-y-0", "opacity-0 -translate-y-2"}
            )
          }
          aria-label="Toggle menu"
        >
          <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"
            />
          </svg>
        </button>
      </div>
      
<!-- Mobile menu -->
      <nav id="mobile-menu" class="sm:hidden hidden pb-4 border-t border-gray-100 pt-2">
        <div class="flex flex-col gap-2">
          <a
            :if={assigns[:store]}
            href={"/s/#{@store.slug}"}
            class="px-2 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 rounded-lg"
          >
            Home
          </a>
          <a
            :if={assigns[:store]}
            href={"/s/#{@store.slug}/products"}
            class="px-2 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 rounded-lg"
          >
            Products
          </a>
          <a
            :if={assigns[:store]}
            href={"/s/#{@store.slug}/cart"}
            class="px-2 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 rounded-lg flex items-center gap-2"
          >
            Cart
            <span
              :if={assigns[:cart_count] && @cart_count > 0}
              class="bg-indigo-600 text-white text-xs font-bold rounded-full w-5 h-5 flex items-center justify-center"
            >
              {@cart_count}
            </span>
          </a>
        </div>
      </nav>
    </div>
  </header>
  <!-- Flash messages -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 w-full">
    <.flash_group flash={@flash} />
  </div>
  <!-- Main content -->
  <main class="flex-1">
    {@inner_content}
  </main>
  <!-- Footer -->
  <footer class="border-t border-gray-200 bg-gray-50 mt-auto">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
      <div class="text-center text-sm text-gray-500">
        <p :if={assigns[:store]}>
          &copy; {Date.utc_today().year} {@store.name}. All rights reserved.
        </p>
        <p class="mt-1">
          Powered by <span class="font-semibold text-gray-700">Emakola</span>
        </p>
      </div>
    </div>
  </footer>
</div>
