<div class="min-h-screen bg-slate-50 px-4 py-6">
  <div class="mx-auto w-full max-w-md space-y-5">
    <header class="text-center">
      <p class="text-sm font-semibold uppercase tracking-wide text-slate-500">Makola</p>
      <p :if={@fulfillment} class="mt-1 text-lg font-bold text-slate-900">
        Order {order_number(@fulfillment)}
      </p>
    </header>

    <p
      :if={@error}
      role="alert"
      class="rounded-2xl bg-amber-100 px-4 py-3 text-center text-base font-semibold text-amber-900"
    >
      {@error}
    </p>

    <%!-- Every failure cause collapses into one screen. A stranger learns
          nothing they could not already guess, and the supplier gets one
          sentence instead of four. --%>
    <section :if={@screen == :link_dead} class="rounded-2xl bg-white p-6 text-center shadow-sm">
      <svg class="mx-auto h-16 w-16 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5 21 3m0 0h-5.25M21 3v5.25M3 5.25A2.25 2.25 0 0 1 5.25 3h1.5a2.25 2.25 0 0 1 2.25 2.25v1.5A2.25 2.25 0 0 1 6.75 9h-1.5A2.25 2.25 0 0 1 3 6.75v-1.5Z" />
      </svg>
      <p class="mt-4 text-lg font-bold text-slate-900">This link no longer works.</p>
      <p class="mt-2 text-base text-slate-600">Ask the shop to send a new one.</p>
    </section>

    <%!-- Before accepting: what to ship and roughly where. No buyer name, no
          street, no phone, no prices. A forwarded pre-accept link leaks almost
          nothing. --%>
    <section :if={@screen in [:offer, :accepted]} class="rounded-2xl bg-white p-4 shadow-sm">
      <h2 class="text-base font-bold text-slate-900">Please send</h2>

      <ul class="mt-3 space-y-3">
        <li :for={item <- line_items(@fulfillment)} class="flex items-center gap-3">
          <img
            :if={item_image(item)}
            src={item_image(item)}
            alt={item_title(item)}
            width="96"
            height="96"
            loading="lazy"
            class="h-24 w-24 flex-none rounded-xl object-cover"
          />
          <div
            :if={is_nil(item_image(item))}
            class="flex h-24 w-24 flex-none items-center justify-center rounded-xl bg-slate-200 text-2xl font-bold text-slate-500"
            aria-hidden="true"
          >
            {String.first(item_title(item))}
          </div>

          <div class="min-w-0 flex-1">
            <p class="truncate text-base font-semibold text-slate-900">{item_title(item)}</p>
            <%!-- Quantity as a big numeral: read by people who do not read words. --%>
            <p class="text-3xl font-black text-slate-900">× {item.quantity}</p>
          </div>
        </li>
      </ul>
    </section>

    <section :if={@screen == :offer} class="rounded-2xl bg-white p-4 shadow-sm">
      <h2 class="text-base font-bold text-slate-900">Deliver to</h2>
      <p class="mt-1 text-2xl font-black text-slate-900">{town(@fulfillment)}</p>
      <p class="mt-1 text-sm text-slate-500">Full address after you accept.</p>
    </section>

    <div :if={@screen == :offer} id="offer-actions" class="space-y-3">
      <button
        type="button"
        phx-click="accept"
        class="flex min-h-16 w-full items-center justify-center gap-3 rounded-2xl bg-emerald-600 px-4 text-xl font-bold text-white active:bg-emerald-700"
      >
        <svg class="h-8 w-8 flex-none" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
        </svg>
        I have it
      </button>

      <button
        type="button"
        phx-click={JS.push("confirm_decline") |> JS.hide(to: "#offer-actions") |> JS.show(to: "#decline-confirm")}
        class="flex min-h-16 w-full items-center justify-center gap-3 rounded-2xl bg-white px-4 text-xl font-bold text-red-700 ring-2 ring-red-200 active:bg-red-50"
      >
        <svg class="h-8 w-8 flex-none" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
        No stock
      </button>
    </div>

    <%!-- Confirmation without a round-trip and without a CSS-checkbox toggle,
          which LiveView's DOM diffing loses. --%>
    <div id="decline-confirm" hidden={not @confirming_decline} class="space-y-3 rounded-2xl bg-white p-4 shadow-sm">
      <p class="text-center text-lg font-bold text-slate-900">Tell the shop you have no stock?</p>

      <button
        type="button"
        phx-click="decline"
        class="min-h-16 w-full rounded-2xl bg-red-600 px-4 text-xl font-bold text-white active:bg-red-700"
      >
        Yes, no stock
      </button>

      <button
        type="button"
        phx-click={JS.push("cancel_decline") |> JS.hide(to: "#decline-confirm") |> JS.show(to: "#offer-actions")}
        class="min-h-16 w-full rounded-2xl bg-slate-100 px-4 text-xl font-bold text-slate-700"
      >
        Go back
      </button>
    </div>

    <%!-- After accepting the supplier gets the full address. They need it, and
          they need to be able to forward it to their own rider. --%>
    <section :if={@screen == :accepted} class="rounded-2xl bg-white p-4 shadow-sm">
      <h2 class="text-base font-bold text-slate-900">Deliver to</h2>
      <p class="mt-1 text-xl font-bold text-slate-900">{buyer_name(@fulfillment)}</p>
      <p class="mt-1 text-base text-slate-700">{street(@fulfillment)}</p>

      <a
        :if={buyer_phone(@fulfillment)}
        href={"tel:#{buyer_phone(@fulfillment)}"}
        class="mt-3 flex min-h-16 w-full items-center justify-center gap-3 rounded-2xl bg-slate-100 px-4 text-xl font-bold text-slate-900"
      >
        <svg class="h-8 w-8 flex-none" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
        </svg>
        Call
      </a>
    </section>

    <.form
      :if={@screen == :accepted}
      for={@tracking_form}
      phx-submit="mark_sent"
      class="space-y-3 rounded-2xl bg-white p-4 shadow-sm"
    >
      <label for="shipment_tracking_number" class="block text-base font-bold text-slate-900">
        Tracking number
      </label>
      <input
        type="text"
        id="shipment_tracking_number"
        name="shipment[tracking_number]"
        value={@tracking_form[:tracking_number].value}
        inputmode="text"
        autocomplete="off"
        class="min-h-14 w-full rounded-xl border-2 border-slate-200 px-4 text-lg"
      />

      <button
        type="submit"
        class="flex min-h-16 w-full items-center justify-center gap-3 rounded-2xl bg-blue-600 px-4 text-xl font-bold text-white active:bg-blue-700"
      >
        <svg class="h-8 w-8 flex-none" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h.375c.621 0 1.125-.504 1.125-1.125V14.25m-17.25 0h17.25" />
        </svg>
        I sent it
      </button>
    </.form>

    <section :if={@screen == :sent} class="rounded-2xl bg-white p-6 text-center shadow-sm">
      <svg class="mx-auto h-20 w-20 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
      </svg>
      <p class="mt-4 text-xl font-bold text-slate-900">Thank you.</p>
      <p class="mt-2 text-base text-slate-600">The shop knows you sent it.</p>
      <p :if={@fulfillment.tracking_number} class="mt-3 text-lg font-bold text-slate-900">
        {@fulfillment.tracking_number}
      </p>
    </section>

    <section :if={@screen == :declined} class="rounded-2xl bg-white p-6 text-center shadow-sm">
      <svg class="mx-auto h-20 w-20 text-red-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
      <p class="mt-4 text-xl font-bold text-slate-900">You said no stock.</p>
      <p class="mt-2 text-base text-slate-600">The shop has been told.</p>
    </section>

    <section :if={@screen == :closed} class="rounded-2xl bg-white p-6 text-center shadow-sm">
      <p class="text-xl font-bold text-slate-900">This order is finished.</p>
    </section>
  </div>
</div>
