#!/bin/sh

# Fly.io BEAM clustering (standard Fly Elixir setup).
#
# Name each node after its 6PN private IPv6 address so DNSCluster
# (DNS_CLUSTER_QUERY, see config/runtime.exs and fly.toml) can discover
# and connect the machines. ERL_AFLAGS="-proto_dist inet6_tcp" is set in
# the Dockerfile/fly.toml so distribution speaks IPv6.
#
# Outside Fly (FLY_PRIVATE_IP unset) the release keeps its defaults.
if [ -n "${FLY_PRIVATE_IP}" ]; then
  export RELEASE_DISTRIBUTION="name"
  export RELEASE_NODE="${FLY_APP_NAME}@${FLY_PRIVATE_IP}"
fi
